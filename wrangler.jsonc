{
  // blueyolk.org on Cloudflare Workers.
  // Site files: ./holding (static assets). /api/treat: the video treatment container (./backend).
  // The name must match the Worker's name in the Cloudflare dashboard.
  "name": "blueyolk",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./holding",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "containers": [
    { "class_name": "Treat", "image": "./backend/Dockerfile", "max_instances": 2, "instance_type": "standard-2" }
  ],
  "durable_objects": { "bindings": [{ "name": "TREAT", "class_name": "Treat" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Treat"] }],
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 4, "period": 60 } }]
}
